// The Students Hub — Neon PostgreSQL schema
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  moduleFormat    = "esm"
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  manager
  admin
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String
  /// AES-256-GCM ciphertext so admins can recover a member's password.
  passwordCipher String?

  name           String     @default("")
  preferredName  String?
  profilePicture String?
  phoneNumber    String?
  dateOfBirth    String?
  role           Role       @default(user)
  createdAt      DateTime   @default(now())
  lastActiveAt   DateTime?

  notes     Note[]
  events    Event[]
  loginLogs LoginLog[]

  @@map("users")
}

model LoginLog {
  id         String   @id @default(cuid())
  email      String
  name       String?
  /// sign_in | sign_out | failed_login | password_change | account_created
  event      String   @default("sign_in")
  timestamp  DateTime @default(now())
  ipAddress  String?
  device     String?
  deviceType String?
  userAgent  String?
  browser    String?
  os         String?
  sessionId  String?
  detail     String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([timestamp])
  @@index([event])
  @@map("login_logs")
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  date      DateTime @default(now())
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("notes")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  images      Json     @default("[]")
  date        DateTime @default(now())
  location    String?
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("events")
}

/// Single shared document that keeps every signed-in device in sync
/// (announcements, suggestions, tasks, home layout, live note answers...).
model SharedState {
  id        String   @id @default("hub")
  data      Json     @default("{}")
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("shared_state")
}

/// Durable activity trail shown in admin monitoring + per-account history.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  name       String?
  area       String
  action     String
  detail     String?
  metadata   Json?
  ipAddress  String?
  device     String?
  deviceType String?
  userAgent  String?
  browser    String?
  os         String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("activity_logs")
}
